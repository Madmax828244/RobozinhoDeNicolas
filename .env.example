# Copie para .env e preencha. NUNCA publique o .env nem as chaves.

# --- Identidade ---
BOT_NAME=Robô Nicolas 🤖
BOT_PREFIX=.
# Números dos donos (somente dígitos, com DDI), separados por vírgula. Ex.: 5511999999999
OWNER_IDS=
# Informações públicas exibidas no comando .dono (opcional)
OWNER_NAME=
OWNER_CONTACT=

# --- Gateway (ponte <-> bot) ---
HOST=127.0.0.1
PORT=8787
# Segredo longo e aleatório. Gere com:  python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# --- Banco de dados ---
DB_PATH=data/nicolas.db

# --- Inteligência artificial (opcional) ---
# AI_PROVIDER: openai | anthropic | gemini | openrouter | groq | deepseek | ollama | docker-model-runner | openai-compatible
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Groq (https://console.groq.com/keys), OpenAI, OpenRouter, DeepSeek etc.: rode  python3 -m nicolas ia  (reconhece a chave)
# IA reserva, usada se a principal der limite de uso/erro:  python3 -m nicolas ia --reserva
# AI_FALLBACK_PROVIDER=
# AI_FALLBACK_MODEL=
# AI_FALLBACK_API_KEY=
# Transcrição de voz para Groq/OpenAI (padrão whisper-large-v3-turbo / whisper-1):
# AI_STT_MODEL=
# Backup automático do banco (a cada X horas, mantendo N cópias em data/backups/)
# Aviso ao dono quando o bot liga (0 desliga)
# AVISO_INICIO=1
# BACKUP_HORAS=6
# BACKUP_MANTER=7
# Jeito mais fácil para o Gemini (a chave não fica no histórico do terminal):  python3 -m nicolas gemini
# Teste a conexão com:  python3 -m nicolas aitest
# Modelos extras do Gemini (modo esperto): gerar imagem e falar em áudio. Ajuste se o Google mudar os nomes.
# AI_IMAGE_MODEL=gemini-2.5-flash-image
# AI_TTS_MODEL=gemini-2.5-flash-preview-tts
# AI_VOICE=Kore
# Só para provedores compatíveis/auto-hospedados (Ollama: http://127.0.0.1:11434/v1;
# Docker Model Runner: http://127.0.0.1:12434/engines/v1). Configure mais fácil com `python3 -m nicolas ia-local`.
AI_BASE_URL=
# Opção de segurança: 1 permite HTTP sem TLS APENAS para IP privado da rede local (ex.: PC em Wi-Fi).
# Use só se confiar nessa rede. Sem isso, use HTTPS ou localhost.
AI_ALLOW_HTTP_LAN=0

# --- Modo esperto (IA responde no grupo; ligado por grupo com /ativaesperto) ---
# Prefixos extras aceitos além do BOT_PREFIX (separe por vírgula). Padrão: "/"
EXTRA_PREFIXES=/
# Máximo de respostas da IA por minuto em cada grupo (protege a cota da API)
ESPERTO_POR_MINUTO=6
# Responder em voz quando a pessoa mandar áudio (1 = sim, 0 = sempre texto)
ESPERTO_RESPONDE_AUDIO=1
# Nas conversas diretas: minutos de silêncio da IA depois que VOCÊ escreve na conversa
ESPERTO_DM_PAUSA_MIN=10
# Minutos de silêncio no grupo antes de o bot puxar assunto sozinho (entre 8h e 22h)
ESPERTO_OCIOSO_MINUTOS=180

# --- Tradução (opcional; alternativa à IA) ---
# URL de uma instância LibreTranslate, ex.: https://seu-servidor
TRANSLATE_URL=
TRANSLATE_API_KEY=

# --- Serviços externos sem chave ---
WEATHER_ENABLED=1
WEB_SEARCH_ENABLED=1

# --- Limites e segurança ---
RATE_LIMIT_COUNT=8
RATE_LIMIT_WINDOW=10
FLOOD_MESSAGES=6
FLOOD_SECONDS=8
MAX_WARNS=3
# Prefixos de país aceitos pelo anti-fake (55 = Brasil)
ANTIFAKE_PREFIXES=55
TZ_OFFSET_HOURS=-3
LOG_LEVEL=INFO

# --- Ponte WhatsApp (Node) ---
# BOT_URL é calculado a partir de HOST/PORT; só defina se precisar de outro endereço.
# BOT_URL=http://127.0.0.1:8787
AUTH_DIR=auth
SEND_GAP_MS=700

# --- Conexão com o WhatsApp (ponte) ---
# AUTH_METHOD: code (código de pareamento, recomendado no celular) ou qr. Vazio = perguntar ao iniciar.
AUTH_METHOD=
# Número do WhatsApp do bot com DDI, só dígitos (ex.: 5511999999999). Vazio = perguntar ao iniciar.
PAIRING_PHONE=

# --- Voz (áudio) --- modelos de texto não falam; o bot converte a resposta em voz com um destes motores
# AI_TTS_ENGINE: auto | local | gemini | openai   (local = espeak grátis:  pkg install espeak ffmpeg)
# AI_TTS_ENGINE=auto
# AI_TTS_API_KEY=            (só para gemini/openai; prefira:  python3 -m nicolas voz --motor gemini)
# AI_TTS_BASE_URL=           (openai-compatível; padrão https://api.openai.com/v1)
# AI_TTS_COMPAT_MODEL=tts-1
# AI_TTS_COMPAT_VOICE=alloy
# AI_TTS_LOCAL_VOICE=pt-br
